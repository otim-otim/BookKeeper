{
    "name": "otim-otim/bookkeeper",
    "version": "2.0.0",
    "description": "A complete double-entry accounting engine for Laravel: chart of accounts, immutable journals, periods and closing, subledgers, invoices, bills, payments, tax, fixed assets, budgets, tills, bank reconciliation and financial statements.",
    "keywords": ["laravel", "accounting", "bookkeeping", "double-entry", "ledger", "general-ledger", "chart-of-accounts", "sacco"],
    "license": "MIT",
    "authors": [
        {
            "name": "Otim Isaac",
            "email": "otim.idb@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "brick/math": "^0.14.2|^0.15|^0.16|^0.17|^0.18|^0.19|^0.20|^1.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "OtimOtim\\BookKeeper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OtimOtim\\BookKeeper\\BookKeeperServiceProvider"
            ],
            "aliases": {
                "BookKeeper": "OtimOtim\\BookKeeper\\Facades\\BookKeeper"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
