{
    "name": "otimdibossman/bookkeeper",
    "description": "A Laravel package for double-entry bookkeeping and accounting statements.",
    "keywords": ["laravel", "accounting", "bookkeeping", "double-entry", "ledger"],
    "license": "MIT",
    "authors": [
        {
            "name": "Otim Isaaco",
            "email": "otim.idb@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Otimdibossman\\BookKeeper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Otimdibossman\\BookKeeper\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Otimdibossman\\BookKeeper\\BookKeeperServiceProvider"
            ],
            "aliases": {
                "BookKeeper": "Otimdibossman\\BookKeeper\\Facades\\BookKeeper"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
